{
  "name": "excelflow",
  "version": "0.1.0",
  "private": true,
  "description": "ExcelFlow - automacao de tratamento, filtragem e analise de planilhas",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm --filter @excelflow/contracts build && pnpm --filter @excelflow/api build && pnpm --filter @excelflow/web build",
    "dev": "pnpm --parallel --filter @excelflow/api --filter @excelflow/web dev",
    "dev:api": "pnpm --filter @excelflow/api dev",
    "dev:web": "pnpm --filter @excelflow/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "migrate": "pnpm --filter @excelflow/api migrate",
    "infra:up": "docker compose up -d sqlserver",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
