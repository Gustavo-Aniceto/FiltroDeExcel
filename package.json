{
  "name": "excelflow",
  "version": "0.1.0",
  "private": true,
  "description": "ExcelFlow - automacao de tratamento, filtragem e analise de planilhas",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "bootstrap": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @excelflow/contracts build && pnpm --filter @excelflow/api build && pnpm --filter @excelflow/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @excelflow/contracts test",
    "migrate": "pnpm --filter @excelflow/api migrate",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:up": "docker compose up -d sqlserver",
    "db:down": "docker compose stop sqlserver",
    "dev:api": "pnpm --filter @excelflow/api dev",
    "dev:web": "pnpm --filter @excelflow/web dev"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
