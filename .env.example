# ==========================================================
# ExcelFlow - variaveis de ambiente (copie para .env)
# ==========================================================
NODE_ENV=development

# ---------- SQL Server (plano de controle) ----------
MSSQL_SA_PASSWORD=ExcelFlow!Dev2026
DB_HOST=localhost
DB_PORT=1433
DB_NAME=excelflow
DB_USER=sa
DB_PASSWORD=ExcelFlow!Dev2026
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10
DB_POOL_MIN=0

# ---------- API (Node/Fastify) ----------
API_PORT=3333
API_HOST=0.0.0.0
# Origens permitidas no CORS, separadas por virgula
CORS_ORIGINS=http://localhost:5173

# Segredo do JWT de acesso. GERE UM NOVO EM PRODUCAO:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-de-desenvolvimento-por-um-aleatorio-de-48-bytes
JWT_ACCESS_TTL=900            # segundos (15 min)
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false           # true obrigatorio em producao (HTTPS)

# ---------- Engine (Python/FastAPI) ----------
ENGINE_PORT=8000
ENGINE_URL=http://localhost:8000
# Segredo compartilhado API <-> Engine. O engine NUNCA fica exposto publicamente.
ENGINE_SHARED_SECRET=troque-este-segredo-interno-de-desenvolvimento

# ---------- Armazenamento de arquivos ----------
# Diretorio raiz dos arquivos temporarios (originais + parquet derivado)
STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=104857600    # 100 MB
DATASET_TTL_HOURS=72          # exclusao automatica dos datasets apos N horas

# ---------- Frontend ----------
VITE_API_URL=http://localhost:3333
